# Copy to .env to override defaults. Every value is optional.

# External lookups (all fail gracefully when offline)
ENABLE_GEOLOCATION=
ENABLE_DNS=
# WHOIS is slow and often rate limited; leave disabled unless explicitly enabled.
ENABLE_WHOIS=
GEO_API_URL=
HTTP_TIMEOUT=
DNS_TIMEOUT=
THREAT_INTEL_ENABLED=
ABUSEIPDB_API_KEY=
TOR_EXIT_LIST_URL=
THREAT_INTEL_TIMEOUT=
THREAT_INTEL_DNSBL=

# Storage and model locations
DATABASE_URL=
DATABASE_PATH=
MODEL_PATH=
DATASET_PATH=
MAX_EMAIL_BYTES=
MASK_SENSITIVE_FIELDS=
RETENTION_ENABLED=
RETENTION_DAYS=

# Redis and Celery
REDIS_ENABLED=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_TIMEOUT=
REDIS_DNS_TTL=
REDIS_IP_TTL=
REDIS_WHOIS_TTL=
REDIS_THREAT_INTEL_TTL=
CELERY_SOFT_TIME_LIMIT=
CELERY_TIME_LIMIT=
CELERY_RESULT_EXPIRES=
ASYNC_ANALYSIS_ENABLED=

# Docker Compose PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
API_PORT=
