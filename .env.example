# Copy to .env to override defaults. Every value is optional.

# External lookups (all fail gracefully when offline)
ENABLE_GEOLOCATION=true
ENABLE_DNS=true
ENABLE_WHOIS=false        # slow and often rate limited; off by default
GEO_API_URL=http://ip-api.com/json
HTTP_TIMEOUT=4
DNS_TIMEOUT=2.5

# Storage and model locations
DATABASE_PATH=data/emailsentinel.db
MODEL_PATH=models/email_nlp_model.joblib
DATASET_PATH=data/email_dataset.csv
MAX_EMAIL_BYTES=5242880
